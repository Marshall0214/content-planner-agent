# Documentation only: load these in your shell; .env is not automatically read.
MODEL_PROVIDER=openai
MODEL_NAME=
OPENAI_API_KEY=
# Optional: explicitly configured Responses-compatible endpoint. Never auto-selected.
# OPENAI_BASE_URL=
PLANNER_DB=var/planner.sqlite3
MAX_MODEL_TURNS=12
MAX_TOOL_REQUESTS=10
MAX_OPERATION_ATTEMPTS=2
MODEL_TIMEOUT_S=20
TOOL_TIMEOUT_S=3
RUN_TIMEOUT_S=180
# Real mode additionally requires CLI --real-call-limit N (explicit call allowance).

