# Documentation only: load these in your shell; .env is not automatically read.
# Verified local deployment on 2026-11-10; explicit configuration, no auto-discovery at inference time.
MODEL_PROVIDER=ollama
MODEL_NAME=qwen3.5:27b
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
MODEL_TEMPERATURE=0.2
# Explicit setting matches the recorded 27B validation runs.
MODEL_THINK=false
# Local Ollama needs no API key. SDK uses a non-secret placeholder.
# Optional cloud Responses: MODEL_PROVIDER=openai, MODEL_NAME=..., OPENAI_API_KEY=...
PLANNER_DB=var/planner.sqlite3
MAX_MODEL_TURNS=12
MAX_TOOL_REQUESTS=10
MAX_OPERATION_ATTEMPTS=2
MODEL_TIMEOUT_S=20
TOOL_TIMEOUT_S=3
RUN_TIMEOUT_S=180
# Real mode additionally requires CLI --real-call-limit N (explicit call allowance).

